{
  "name": "tenon",
  "version": "0.6.12",
  "description": "Tenon (榫卯) — a consumer super terminal: one small app to drive every device and program at home, by voice/AI, with device binding, one-click install, phone remote and phone-to-desktop handoff",
  "type": "module",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/start.js",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node test/e2e/run-real-browser.js",
    "test:v2": "node scripts/verify-v2.js",
    "e2e": "node test/e2e/run-real-browser.js",
    "test:modules": "node --test \"server/lib/link/__tests__/link.test.mjs\" \"server/lib/assets/__tests__/assets.test.mjs\" \"server/lib/things/__tests__/things.test.mjs\" \"server/lib/enterprise/__tests__/enterprise.test.mjs\" \"server/lib/super/__tests__/super.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/minzzj/tenon.git"
  },
  "keywords": [
    "super-terminal",
    "device-hub",
    "voice-assistant",
    "handoff",
    "local-first",
    "audit",
    "ai"
  ],
  "dependencies": {
    "docx": "^9.15.0",
    "mqtt": "^5.16.1",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "aedes": "^1.2.0"
  }
}
