{
  "name": "tenon-super-terminal",
  "version": "0.6.12",
  "description": "榫卯超级终端 Tenon · 本地 AI 语音助手 / 电脑自动化(RPA) / 手机电脑协同 / 智能家居物联网控制 / 24h 录音与屏幕记录总结",
  "main": "main.js",
  "author": "minzzj",
  "license": "CC-BY-NC-SA-4.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^45.1.0"
  },
  "build": {
    "appId": "com.minzzj.tenon.superterminal",
    "productName": "榫卯超级终端",
    "copyright": "minzzj · CC BY-NC-SA 4.0",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server"
      },
      {
        "from": "../public",
        "to": "public"
      },
      {
        "from": "../scripts",
        "to": "scripts"
      },
      {
        "from": "../node-agent",
        "to": "node-agent"
      },
      {
        "from": "../package.json",
        "to": "package.json"
      },
      {
        "from": "../node_modules",
        "to": "node_modules",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "TenonSuperTerminal-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "TenonSuperTerminal-${version}-portable.${ext}"
    },
    "compression": "normal"
  },
  "keywords": [
    "tenon",
    "榫卯",
    "超级终端",
    "ai-assistant",
    "voice-assistant",
    "pc-automation",
    "rpa",
    "iot",
    "smart-home",
    "screen-capture",
    "speech-to-text",
    "local-first",
    "electron"
  ]
}
