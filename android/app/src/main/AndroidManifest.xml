<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 局域网互联：HTTP + UDP 广播 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 扫码配对 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 语音指令（SpeechRecognizer） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 剪贴板/通知同步前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 0.6.8：手机本机 24h 录音前台服务（Android 14 必须声明 microphone 类型权限） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 0.6.8：悬浮窗（一键唤醒 / 24h 开关，退出 App 后仍可用） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 屏幕内容采集（MediaProjection 前台服务，Android 14 必须声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v0.6.5 一键更新：允许 App 拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <!-- Android 11+ 包可见性：允许发现系统语音识别服务 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tenon"
        android:usesCleartextTraffic="true">

        <!-- V5：文档下载后通过 FileProvider 分享到微信/QQ/邮件 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Tenon.NoActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <activity
            android:name=".AssetsActivity"
            android:exported="false"
            android:label="@string/title_assets" />

        <!-- 通用二级页：设备绑定 / 手机遥控 / 素材库（WebView，内嵌 hub 页面） -->
        <activity
            android:name=".WebPageActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- V4 单程序四页签：设备 / 今日（首页与设置复用 MainActivity/SettingsActivity） -->
        <activity
            android:name=".DevicesActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".TodayActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- V5：记录 / 提醒 / 文档 / IoT -->
        <activity
            android:name=".NotesActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- 0.6.7 记录页：笔记 / 全天录音 / 屏幕记录（与电脑端互通） -->
        <activity
            android:name=".VoiceRecordsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".RemindersActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".DocumentsActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name=".IotActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- 分享目标：从相册/文件管理器直接分享到榫卯 -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_label"
            android:theme="@style/Theme.Tenon.Dialog">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ClipboardSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 屏幕内容采集（每 interval 截屏 JPEG → POST /api/v2/voice/screen） -->
        <service
            android:name=".service.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- 0.6.8：手机本机 24 小时录制（12 秒一段 WAV → /api/v2/voice/ambient-upload） -->
        <service
            android:name=".service.AmbientRecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 0.6.8：悬浮窗（前台保活；展开后一键唤醒 / 24h 开关两个独立按钮） -->
        <service
            android:name=".service.OverlayService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <service
            android:name=".service.TenonNotificationListener"
            android:exported="true"
            android:label="@string/notification_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>