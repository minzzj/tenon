<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tenon" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:textColorPrimary">@color/paper</item>
        <item name="android:textColorSecondary">@color/grey</item>
    </style>

    <style name="Theme.Tenon.NoActionBar" parent="Theme.Tenon">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="Theme.Tenon.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/paper</item>
        <item name="android:colorAccent">@color/cyan</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
</resources>